# ---------------------------------------------------------------------------
# OpsMate - variables de entorno (copiar a .env y ajustar)
# ---------------------------------------------------------------------------

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5434/opsmate
DB_USER=opsmate
DB_PASSWORD=opsmate
POSTGRES_DB=opsmate
POSTGRES_USER=opsmate
POSTGRES_PASSWORD=opsmate

# --- Puertos expuestos ---
BACKEND_PORT=8084
FRONTEND_PORT=5177
SIM_ENV_PORT=8100

# --- Ollama (en el host) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Timeouts (ms) ---
LLM_TIMEOUT_MS=120000
STEP_TIMEOUT_MS=60000

# --- Limites de agente ---
AGENT_MAX_ITERATIONS=10